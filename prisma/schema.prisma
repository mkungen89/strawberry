generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better Auth models
model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  role             Role      @default(USER)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  orders            Order[]
  reviews           Review[]
  subscription      Subscription?
  referralsGiven    Referral[] @relation("referrer")
  referralsReceived Referral[] @relation("referred")
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId   String   @unique
  stripePriceId          String
  planSlug               String   // creator | streamer | business | growth
  status                 String   // active | canceled | past_due | trialing | incomplete
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Vexcraft models
model Service {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  category    ServiceCategory
  basePrice   Float
  features    String[]
  popular     Boolean         @default(false)
  active      Boolean         @default(true)
  imageUrl    String?
  createdAt   DateTime        @default(now())

  orders      Order[]
  packages    ServicePackage[]
}

model ServicePackage {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  description String
  price       Float
  features    String[]
  createdAt   DateTime @default(now())

  service     Service  @relation(fields: [serviceId], references: [id])
  orders      Order[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  serviceId       String
  packageId       String?
  status          OrderStatus @default(PENDING)
  totalPrice      Float
  currency        String      @default("USD")
  details         Json
  techStack       Json?
  hostingProvider String?
  revisions       Int         @default(0)
  maxRevisions    Int         @default(2)
  stripePaymentId String?
  invoiceUrl      String?
  paymentType     String      @default("FULL")
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  service         Service         @relation(fields: [serviceId], references: [id])
  package         ServicePackage? @relation(fields: [packageId], references: [id])
  messages        OrderMessage[]
  review          Review?
  invoices        Invoice[]
  milestones      Milestone[]
  assignments     OrderAssignment[]
  notes           OrderNote[]
  tasks           OrderTask[]
  files           OrderFile[]
  activities      OrderActivity[]
  priority        String      @default("NORMAL")
  deadline        DateTime?
  estimatedHours  Float?
  assignedTeam    String?
  briefLocked     Boolean     @default(false)
  briefLockedAt   DateTime?
  concepts        OrderConcept[]
}

model OrderConcept {
  id          String   @id @default(cuid())
  orderId     String
  title       String
  description String?
  imageUrl    String?
  fileUrl     String?
  status      String   @default("PENDING")
  isSelected  Boolean  @default(false)
  feedback    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderAssignment {
  id          String   @id @default(cuid())
  orderId     String
  memberName  String
  memberRole  String
  assignedAt  DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderNote {
  id          String   @id @default(cuid())
  orderId     String
  authorName  String
  content     String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderTask {
  id          String    @id @default(cuid())
  orderId     String
  title       String
  completed   Boolean   @default(false)
  assignedTo  String?
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderFile {
  id                String   @id @default(cuid())
  orderId           String
  fileName          String
  fileUrl           String
  fileSize          Int?
  fileType          String?
  uploadedBy        String   @default("admin")
  visibleToCustomer Boolean  @default(true)
  createdAt         DateTime @default(now())

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderActivity {
  id          String   @id @default(cuid())
  orderId     String
  action      String
  description String
  actorName   String   @default("System")
  metadata    Json?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Invoice {
  id              String   @id @default(cuid())
  orderId         String
  invoiceNumber   String   @unique
  amount          Float
  currency        String   @default("USD")
  status          String   @default("DRAFT")
  dueDate         DateTime?
  paidAt          DateTime?
  stripeInvoiceId String?
  pdfUrl          String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Milestone {
  id              String   @id @default(cuid())
  orderId         String
  title           String
  description     String?
  amount          Float
  currency        String   @default("USD")
  percentage      Float
  status          String   @default("PENDING")
  dueDate         DateTime?
  completedAt     DateTime?
  paidAt          DateTime?
  stripePaymentId String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  content   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  orderId   String   @unique
  rating    Int
  comment   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String
  discount    Float    @default(10)
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  referrer    User     @relation("referrer", fields: [referrerId], references: [id])
  referred    User     @relation("referred", fields: [referredId], references: [id])
}

enum Role {
  USER
  ADMIN
  ANALYST // Code Analyst / QA role
}

enum ServiceCategory {
  DISCORD
  YOUTUBE
  STREAMING
  WEBSITE
  APP
  GRAPHICS
  CONTENT
  VIDEO
  SEO
  GROWTH
  SOCIAL
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  REVIEW
  REVISION
  COMPLETED
  CANCELLED
}

// ─── Admin Project Management ─────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("GENERAL") // NEW_SERVICES, BUGS, FEATURES, WEBSITE
  status      String   @default("ACTIVE")
  color       String   @default("#9333ea")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]

  @@index([category])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  avatar    String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  socialPosts   SocialPost[]
  socialReplies SocialReply[]
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         String    @default("BACKLOG") // BACKLOG, READY, IN_PROGRESS, REVIEW, DONE
  priority       String    @default("NORMAL")  // LOW, NORMAL, HIGH, URGENT
  progress       Int       @default(0)         // 0–100
  dueDate        DateTime?
  projectId      String?
  assigneeId     String?
  assigneeName   String?
  // QA Workflow fields
  reviewedBy     String?   // TeamMember name of Code Analyst who reviewed
  reviewedById   String?   // TeamMember id
  approvedAt     DateTime? // When task was approved by Code Analyst
  rejectedAt     DateTime? // When task was sent back to IN_PROGRESS
  submittedForReviewAt DateTime? // When dev moved task to REVIEW
  qaStatus       String?   // null | "PENDING" | "APPROVED" | "REJECTED"
  // Task category for role routing
  category       String?   // "development" | "design" | "review" | "management"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     TeamMember?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  updates      TaskUpdate[]

  @@index([status])
  @@index([projectId])
  @@index([assigneeId])
}

model TaskUpdate {
  id         String   @id @default(cuid())
  taskId     String
  authorName String
  content    String
  // QA fields
  updateType String   @default("COMMENT") // COMMENT | STATUS_CHANGE | QA_APPROVED | QA_REJECTED | QA_SUBMITTED
  bugsFound  String[] // List of bugs found during QA review
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── QA Workflow ──────────────────────────────────────────────────────────────

// Extended Task fields for QA workflow (added via schema update)
// reviewedBy, approvedAt, bugsFound are added to Task and TaskUpdate below

// ─── Community Management ─────────────────────────────────────────────────────

model CMMetrics {
  id             String   @id @default(cuid())
  customerId     String
  platform       String   // "discord" | "twitter" | "instagram" | "reddit"
  followers      Int      @default(0)
  engagementRate Float    @default(0)
  postsCount     Int      @default(0)
  reach          Int      @default(0)
  impressions    Int      @default(0)
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([customerId])
  @@index([platform])
  @@index([recordedAt])
}

model CMContent {
  id          String   @id @default(cuid())
  customerId  String
  platform    String   // "discord" | "twitter" | "instagram" | "reddit"
  title       String
  body        String?
  mediaUrl    String?
  status      String   @default("SCHEDULED") // SCHEDULED | POSTED | CANCELLED | DRAFT
  scheduledAt DateTime
  postedAt    DateTime?
  createdBy   String   @default("manager") // manager name or "system"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
}

model CMFeedback {
  id         String   @id @default(cuid())
  customerId String
  rating     Int      // 1–5
  comment    String?
  category   String   @default("GENERAL") // GENERAL | CONTENT | RESPONSE_TIME | RESULTS | MANAGER
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ─── Live Chat ────────────────────────────────────────────────────────────────

// Live Chat
model ChatConversation {
  id           String        @id @default(cuid())
  visitorName  String        @default("Visitor")
  visitorEmail String?
  status       String        @default("OPEN")
  assignedTo   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  closedAt     DateTime?

  messages     ChatMessage[]

  @@index([status])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  content        String
  senderType     String           @default("VISITOR")
  senderName     String           @default("Visitor")
  createdAt      DateTime         @default(now())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Discord Bot ──────────────────────────────────────────────────────────────

model DiscordSetupOrder {
  id         String   @id @default(cuid())
  orderId    String   @unique
  guildId    String
  guildName  String
  claimedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([guildId])
  @@index([orderId])
}

// ─── Email AI Integration ────────────────────────────────────────────────────

model EmailThread {
  id             String    @id @default(cuid())
  from           String
  subject        String
  originalEmail  String    @db.Text
  aiResponse     String?   @db.Text
  status         String    @default("PENDING") // PENDING | DRAFT | SENT | FAILED
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  sentAt         DateTime?
  failureReason  String?
  messageId      String?   @unique // Email Message-ID for tracking
  inReplyTo      String?   // Message-ID we're replying to
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([receivedAt])
  @@index([from])
}

model EmailDraft {
  id             String    @id @default(cuid())
  emailThreadId  String    @unique
  to             String
  subject        String
  body           String    @db.Text
  approved       Boolean   @default(false)
  approvedAt     DateTime?
  approvedBy     String?   // Admin name who approved
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([approved])
}

// ─── Social Media ─────────────────────────────────────────────────────────────

model SocialAccount {
  id           String    @id @default(cuid())
  platform     String    @unique // "X" | "PINTEREST" | "REDDIT"
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  accountName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SocialPost {
  id          String    @id @default(cuid())
  platform    String    // "X" | "PINTEREST" | "REDDIT"
  content     String    @db.Text
  title       String?   // Pinterest/Reddit title
  link        String?   // Pinterest destination URL
  boardId     String?   // Pinterest board ID
  boardName   String?   // Pinterest board name
  imageUrl    String?   // Pinterest pin image
  subreddit   String?   // Reddit subreddit
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | FAILED
  authorId    String
  authorName  String
  externalId  String?   // Post ID on the platform
  externalUrl String?   // URL of the post
  errorMsg    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author  TeamMember    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies SocialReply[]

  @@index([platform, status])
  @@index([authorId])
}

model SocialReply {
  id          String    @id @default(cuid())
  postId      String
  content     String    @db.Text
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | FAILED
  authorId    String
  authorName  String
  externalId  String?
  errorMsg    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author TeamMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model CostEntry {
  id         String   @id @default(cuid())
  name       String
  amountUsd  Float
  amountRaw  Float
  currency   String   @default("USD")
  category   String   @default("TOOL")
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Testimonials ─────────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  handle    String?
  service   String
  stars     Int      @default(5)
  text      String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// ─── Portfolio ────────────────────────────────────────────────────────────────

model PortfolioProject {
  id          String   @id @default(cuid())
  title       String
  service     String
  category    String   // Discord, YouTube, Streaming, Website, App, Branding
  description String
  imageUrl    String?
  gradient    String   @default("from-purple-600 via-pink-600 to-rose-600")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([category])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  source       String
  inputTokens  Int
  outputTokens Int
  model        String   @default("claude-haiku-4-5-20251001")
  costUsd      Float
  orderId      String?
  createdAt    DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}
